---
import '../styles/styles.css';

interface Props {
  title?: string;
}

const { title = 'Oxford Salsa Society — Salsa & Bachata classes in Oxford' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Oxford University's salsa & bachata society. Weekly classes, an open practica, and a monthly club night. Beginners welcome — no partner, no experience needed." />
    <link rel="icon" href="/assets/favico.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/favico.webp" type="image/webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
