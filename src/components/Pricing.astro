---
import { PRICING } from '../data.js';
---
<section id="pricing" class="section shell">
  <div class="section-head">
    <div>
      <div class="num" style="padding-bottom: 30px">03 —<br /> Membership </div>
      <a href="https://ticketscandy.com/e/oxford-university-salsa-society-26-27-21351" class="btn btn-membership"> 
        Buy a Membership 
      </a>
    </div>
    <div>
      <h2>One card, every class.</h2>
      <p class="lede" style="margin-top: 24px;">
        Membership is open to Oxford University students and staff — associate cards are
        available to members of the public with the same perks. Drop-in is welcome, but the
        termly card is what most of the society picks up in week one.
      </p>
    </div>
  </div>
  <div class="pricing-grid">
    {PRICING.map((p) => (
      <div class={`price-card ${p.featured ? 'featured' : ''}`}>
        {p.tag && <span class="tag">{p.tag}</span>}
        <div class="name">{p.name}</div>
        <div class="price"><sup>£</sup>{p.price}<small>{p.suffix}</small></div>
        <ul>
          {p.features.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
