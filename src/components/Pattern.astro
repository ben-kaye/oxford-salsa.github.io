---
interface Props {
  kind?: 'diagonal' | 'dots' | 'stripes';
  hue?: number;
  dark?: boolean;
}

const { kind = 'diagonal', hue = 18, dark = false } = Astro.props;

const fg = `oklch(0.50 0.16 ${hue})`;
const bg = dark ? '#1a0d0a' : `oklch(0.92 0.06 ${hue})`;
const stroke = dark ? `oklch(0.78 0.16 ${hue})` : `oklch(0.40 0.18 ${hue})`;

const svgStyle = 'width: 100%; height: 100%; display: block;';
---
{kind === 'diagonal' && (
  <svg viewBox="0 0 300 400" preserveAspectRatio="none" style={svgStyle}>
    <rect width="300" height="400" fill={bg} />
    {Array.from({ length: 22 }).map((_, i) => (
      <line
        x1={-100 + i * 22} y1={0}
        x2={-100 + i * 22 + 200} y2={400}
        stroke={stroke} stroke-width={4} opacity={0.55}
      />
    ))}
    <circle cx={240} cy={70} r={36} fill={fg} opacity={0.85} />
  </svg>
)}
{kind === 'dots' && (
  <svg viewBox="0 0 300 400" preserveAspectRatio="none" style={svgStyle}>
    <rect width="300" height="400" fill={bg} />
    {Array.from({ length: 12 }).flatMap((_, r) =>
      Array.from({ length: 10 }).map((_, c) => (
        <circle
          cx={15 + c * 32} cy={15 + r * 32}
          r={r % 2 === c % 2 ? 6 : 2.5}
          fill={stroke} opacity={0.85}
        />
      ))
    )}
    <rect x={40} y={150} width={220} height={100} fill={fg} opacity={0.9} />
  </svg>
)}
{kind === 'stripes' && (
  <svg viewBox="0 0 300 400" preserveAspectRatio="none" style={svgStyle}>
    <rect width="300" height="400" fill={fg} />
    {Array.from({ length: 14 }).map((_, i) => (
      <rect x={0} y={i * 30} width={300} height={14} fill={bg} opacity={0.85} />
    ))}
    <circle cx={150} cy={200} r={90} fill={fg} stroke={bg} stroke-width={10} />
  </svg>
)}
