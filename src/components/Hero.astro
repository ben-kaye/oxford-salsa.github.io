---
import Marquee from './Marquee.astro';
import { TERM, SOCIALS, TERM_CARD } from '../data.js';

// Compute current term week (build-time). Rebuilds on git push.
const today = new Date();
today.setHours(0, 0, 0, 0);
const [sy, sm, sd] = TERM.startSunday.split('-').map(Number);
const termStart = new Date(sy, sm - 1, sd);
const dayMs = 86_400_000;
const weeksSinceStart = Math.floor((today.getTime() - termStart.getTime()) / (7 * dayMs));

let termValue;
if (today < termStart) {
  termValue = 'Pre-term';
} else if (weeksSinceStart >= TERM.weeks) {
  termValue = 'Out of term';
} else {
  termValue = `Wk ${weeksSinceStart + 1} / ${TERM.weeks}`;
}

// Next upcoming social — only show if a real, non-closed entry exists.
const nextSocial = (SOCIALS ?? []).find((s) => !s.closed) ?? null;

// Next 3 upcoming class events (build-time). Walks days forward until 3 events
// are found or the term ends. Same-day events count as upcoming until midnight.
function addDaysLocal(d, n) { const x = new Date(d); x.setDate(x.getDate() + n); return x; }
function startTimeMinutes(ev) {
  const t = ev.classes?.[0]?.time ?? '';
  const m = t.match(/(\d{1,2}):(\d{2})/);
  return m ? parseInt(m[1], 10) * 60 + parseInt(m[2], 10) : 0;
}
function shortVenue(v) {
  return (v || '').replace(/\s+(Church|Hall|Centre|Center|Society)$/i, '').trim();
}
const upcomingFromDate = today < termStart ? termStart : today;
const scanDays = Math.max(0, TERM.weeks * 7 + 7);
const upcoming = [];
for (let i = 0; i < scanDays && upcoming.length < 3; i++) {
  const d = addDaysLocal(upcomingFromDate, i);
  const weekIdx = Math.floor((d.getTime() - termStart.getTime()) / (7 * dayMs));
  const weekNum = weekIdx + 1;
  if (weekNum < 1 || weekNum > TERM.weeks) continue;
  const dow = d.getDay();
  const matches = TERM_CARD
    .filter((ev) => ev.dayOfWeek === dow && (!Array.isArray(ev.weeks) || ev.weeks.includes(weekNum)))
    .sort((a, b) => startTimeMinutes(a) - startTimeMinutes(b));
  for (const ev of matches) {
    upcoming.push({
      key: `${d.toISOString().slice(0, 10)}-${ev.id}`,
      label: d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }),
      title: ev.title,
      venue: shortVenue(ev.venue),
    });
    if (upcoming.length >= 3) break;
  }
}
---
<section class="hero shell">
  <div class="hero-grid-asymmetric">
    <div>
      <div class="eyebrow" style="margin-bottom: 28px;">— {TERM.name}</div>
      <h1 class="display" style="color: var(--oxblood);">Come dance!</h1>
      <div class="hero-meta">
        <div class="item">
          <div class="label">{TERM.name}</div>
          <div class="val" id="term-week-val">{termValue}</div>
        </div>
        <div class="item">
          <div class="label">Next social</div>
          <div class="val">{nextSocial ? nextSocial.when : 'TBA'}</div>
        </div>
      </div>
      <div class="hero-cta-row">
        <a href="#schedule" class="btn">See the week →</a>
        <a href="#pricing" class="btn btn-ghost">Become a member</a>
      </div>
    </div>
    <div class="hero-aside">
      <figure class="hero-photo">
        <img
          src="/assets/images/bg_class.jpg"
          alt="Oxford Salsa Society members on a class night"
          width="1000"
          height="750"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
      <p>
        Oxford's salsa &amp; bachata society. Salsa on Mondays, bachata on Thursdays —
        beginners welcome, no partner required.
      </p>
      {upcoming.length > 0 && (
        <>
          <div class="eyebrow ticker-label">— Upcoming</div>
          <div class="ticker">
            {upcoming.map((u) => (
              <div class="row">
                <span>{u.label}</span>
                <span class="style">{u.title}</span>
                <span>{u.venue}</span>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
  <Marquee />
</section>

<script define:vars={{ startSunday: TERM.startSunday, weeks: TERM.weeks }}>
  // Recompute term week on the client so the label stays accurate between deploys.
  (function () {
    const el = document.getElementById('term-week-val');
    if (!el) return;
    const [y, m, d] = startSunday.split('-').map(Number);
    const start = new Date(y, m - 1, d);
    start.setHours(0, 0, 0, 0);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const weeksSinceStart = Math.floor((today.getTime() - start.getTime()) / (7 * 86_400_000));
    let value;
    if (today < start) {
      value = 'Pre-term';
    } else if (weeksSinceStart >= weeks) {
      value = 'Out of term';
    } else {
      value = 'Wk ' + (weeksSinceStart + 1) + ' / ' + weeks;
    }
    if (el.textContent !== value) el.textContent = value;
  })();
</script>
